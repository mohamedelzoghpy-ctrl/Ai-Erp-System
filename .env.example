# Copy to .env and fill in. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me
# 48 بايت عشوائية: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# تدوير المفتاح يبطل كل الجلسات الحالية (دخول واحد من جديد).
SECRET_KEY=change-me-to-a-long-random-string-min-32-bytes

# Optional
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins allowed to call the API (needed once a web frontend is on another origin)
CORS_ORIGINS=http://localhost:5173

# Printed on exported invoices / purchase orders (PDF and Excel)
COMPANY_NAME=اسم شركتك
COMPANY_PHONE=
COMPANY_ADDRESS=
CURRENCY_LABEL=ج.م
EXPORT_TIMEZONE=Africa/Cairo

# كلمة سر تجديد رخصة الاستخدام (سر المورّد) — إلزامية لتفعيل التجديد
LICENSE_RENEWAL_PASSWORD=
